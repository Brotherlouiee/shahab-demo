# Local Docker Compose only. Copy to .env and replace every value before use outside development.
SHAHAB_ENVIRONMENT=local
SHAHAB_LOG_LEVEL=INFO
SHAHAB_DATABASE_URL=postgresql+psycopg://shahab:change-me-local-only@postgres:5432/shahab
SHAHAB_READINESS_TOKEN=change-me-local-only
SHAHAB_REDIS_URL=redis://redis:6379/0
POSTGRES_DB=shahab
POSTGRES_USER=shahab
POSTGRES_PASSWORD=change-me-local-only

SHAHAB_PROFILE_MOCK_OTP_ENABLED=true

# Live SMS is OFF until template approval and a separately authorized server test.
# Keep keys and the independent OTP derivation secret only in the server secret store.
SHAHAB_KAVENEGAR_OTP_ENABLED=false
SHAHAB_KAVENEGAR_TEMPLATE_APPROVED=false
SHAHAB_KAVENEGAR_API_KEY=
SHAHAB_KAVENEGAR_TEMPLATE=
SHAHAB_OTP_CODE_SECRET=
SHAHAB_KAVENEGAR_TIMEOUT_SECONDS=5

