# VM only. Copy to .env.prod, chmod 600, fill privately; never use the local .env.
# Empty required values fail Compose validation. No passwords or API keys are supplied.
POSTGRES_DB=shahab
POSTGRES_USER=shahab_migrator
POSTGRES_PASSWORD=
# URL-encode database passwords. Hostname postgres is the private Compose service.
# API URL must use a separate non-owner LOGIN role, already provisioned with runtime grants.
SHAHAB_DATABASE_URL=
SHAHAB_MIGRATION_DATABASE_URL=
SHAHAB_READINESS_TOKEN=
# Lowercase certificate DNS hostname only: no https://, path or port.
SHAHAB_PUBLIC_HOST=
# Absolute existing directory: fullchain.pem and privkey.pem readable by container UID/GID 101.
SHAHAB_TLS_DIRECTORY=
# Default is loopback; use 0.0.0.0 only for approved deployment with host firewall/DNS/TLS ready.
SHAHAB_BIND_IP=127.0.0.1
SHAHAB_HTTP_PORT=80
SHAHAB_HTTPS_PORT=443
# Choose a non-overlapping bridge subnet; frontend IP must belong to it.
SHAHAB_APP_SUBNET=172.30.50.0/24
SHAHAB_FRONTEND_IP=172.30.50.10
# No real SMS until OTP1 approval and separately authorized activation.
SHAHAB_KAVENEGAR_OTP_ENABLED=false
SHAHAB_KAVENEGAR_TEMPLATE_APPROVED=false
SHAHAB_KAVENEGAR_API_KEY=
SHAHAB_KAVENEGAR_TEMPLATE=OTP1
SHAHAB_OTP_CODE_SECRET=
