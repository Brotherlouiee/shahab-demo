    "interestRate": ["rate_0_4", "rate_5_14", "rate_15_20", "rate_21_23", "rate_gt_23"],
    "depositRequired": ["deposit_required", "deposit_not_required"],
    "depositHoldingMonths": ["holding_up_to_1m", "holding_1_3m", "holding_3_6m", "holding_6_12m", "holding_gt_12m"],
    "loanToDepositRatio": ["ratio_lt_100", "ratio_100_200", "ratio_200_400", "ratio_gt_400"],
    "guaranteeType": ["hardCollateral", "thirdPartyUndertaking", "personalUndertaking"]
