  "item": [
    {
      "item": [
        {
          "event": [],
          "name": "POST /api/v1/account-access/logout",
          "request": {
            "auth": {
              "bearer": [
                {
                  "key": "token",
                  "type": "string",
                  "value": "{{accessToken}}"
                }
              ],
              "type": "bearer"
            },
            "description": "Revokes the current account session and clears its cookie. Protected requests subsequently return 401; run this after completing the manual test flow.",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "account-access",
                "logout"
              ],
              "query": [],
              "raw": "{{baseUrl}}/api/v1/account-access/logout"
            }
          },
          "response": []
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const value = pm.response.json();",
                  "  pm.environment.set(\"challengeId\", value[\"challengeId\"]);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "POST /api/v1/account-access/request",
          "request": {
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"phone\": \"{{testPhone}}\"\n}"
            },
            "description": "Request Code",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "account-access",
                "request"
              ],
              "query": [],
              "raw": "{{baseUrl}}/api/v1/account-access/request"
            }
          },
          "response": []
        },
        {
          "event": [],
          "name": "GET /api/v1/account-access/session",
          "request": {
            "auth": {
              "bearer": [
                {
                  "key": "token",
                  "type": "string",
                  "value": "{{accessToken}}"
                }
              ],
              "type": "bearer"
            },
            "description": "Current Session",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "account-access",
                "session"
              ],
              "query": [],
              "raw": "{{baseUrl}}/api/v1/account-access/session"
            }
          },
          "response": []
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const value = pm.response.json();",
                  "  pm.environment.set(\"accessToken\", value[\"accessToken\"]);",
                  "  pm.environment.set(\"testPhone\", value[\"phone\"]);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "POST /api/v1/account-access/verify",
          "request": {
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"code\": \"{{otpCode}}\"\n}"
            },
            "description": "Local/test verification creates or reuses the database profile and sets an HttpOnly account cookie. Mock OTP is forbidden in staging/production. No real phone ownership is asserted.",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "account-access",
                "verify"
              ],
              "query": [],
              "raw": "{{baseUrl}}/api/v1/account-access/verify"
            }
          },
          "response": []
        }
      ],
      "name": "account-access"
