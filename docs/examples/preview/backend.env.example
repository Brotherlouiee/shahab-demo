# INERT DOCUMENTATION ONLY. Not read by Compose, FastAPI, CI or Netlify.
# Do not use this incomplete example to start a deployment.
# Fill secret values only in the authorized API server secret store.
SHAHAB_ENVIRONMENT=staging
SHAHAB_DEBUG=false
SHAHAB_LOG_LEVEL=INFO
SHAHAB_API_DOCS_INCLUDE_OPERATIONS=false
# Exact approved frontend HTTPS origin(s), comma separated; never wildcard.
SHAHAB_CORS_ALLOWED_ORIGINS=https://preview.example.invalid
SHAHAB_DATABASE_URL=
SHAHAB_REDIS_URL=
SHAHAB_READINESS_TOKEN=
SHAHAB_PROFILE_MOCK_OTP_ENABLED=false
# Keep live SMS disabled until actual template approval AND owner authorization.
SHAHAB_KAVENEGAR_OTP_ENABLED=false
SHAHAB_KAVENEGAR_TEMPLATE_APPROVED=false
SHAHAB_KAVENEGAR_API_KEY=
SHAHAB_KAVENEGAR_TEMPLATE=OTP1
SHAHAB_OTP_CODE_SECRET=
SHAHAB_KAVENEGAR_TIMEOUT_SECONDS=5
