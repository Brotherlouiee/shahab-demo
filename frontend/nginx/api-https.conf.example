# INERT EXAMPLE; replace the .invalid host and mount as /etc/nginx/shahab-api.conf.
# For an external TLS terminator, separately review trusted host/scheme handling.
# Never trust arbitrary client X-Forwarded-* headers or disable upstream TLS checks.
location /api/v1/ {
    # No URI suffix: preserves the entire /api/v1 path and query.
    proxy_pass https://api.example.invalid;
    proxy_ssl_server_name on;
    proxy_ssl_name api.example.invalid;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    proxy_cache off;
    proxy_intercept_errors off;
    proxy_next_upstream off;
}
